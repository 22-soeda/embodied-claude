{
  "autoMemoryEnabled": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "session-start"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "user-prompt-submit"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "pre-tool-use"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "post-tool-use"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "post-tool-use-failure"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "post-tool-batch"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "stop"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--package",
              "individual-kernel-mcp",
              "efpf-hook",
              "stop-failure"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
